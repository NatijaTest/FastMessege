          },
          "$other": {
            ".validate": "root.child('admins').child(auth.uid).val() === true"
          }
        },
        "sale": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && ((!data.exists() && newData.exists() && root.child('config').child('sellOff').val() !== true && root.child('gifts').child($uid).child(newData.child('key').val()).exists() && root.child('gifts').child($uid).child(newData.child('key').val()).child('price').val() > 0 && newData.child('amount').val() === root.child('gifts').child($uid).child(newData.child('key').val()).child('price').val() * 4 / 5) || (data.exists() && !newData.exists()))))",
          ".validate": "newData.hasChildren(['key', 'amount']) || !newData.exists()",
          "key": {
            ".validate": "newData.isString()"
          },
          "amount": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": "root.child('admins').child(auth.uid).val() === true"
          }
        },
        "$other": {
          ".validate": "root.child('admins').child(auth.uid).val() === true"
        }
      }
    },
    "gifts": {
      "$rid": {
        ".read": "auth != null && (auth.uid === $rid || root.child('admins').child(auth.uid).val() === true || root.child('moderators').child(auth.uid).val() === true)",
        "$gid": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('from').val() === auth.uid && newData.child('price').val() > 0 && root.child('stars').child(auth.uid).child('pending').child('key').val() === $gid && root.child('stars').child(auth.uid).child('pending').child('giftId').val() === newData.child('giftId').val() && root.child('stars').child(auth.uid).child('pending').child('to').val() === $rid && root.child('stars').child(auth.uid).child('pending').child('price').val() === newData.child('price').val()) || (auth.uid === $rid && !data.exists() && !root.child('soldKeys').child($rid).child($gid).exists() && newData.child('from').val() === auth.uid && root.child('cases').child(auth.uid).child('key').val() === $gid && root.child('cases').child(auth.uid).child('giftId').val() === newData.child('giftId').val() && root.child('cases').child(auth.uid).child('price').val() === newData.child('price').val()) || (auth.uid === $rid && !data.exists() && !root.child('soldKeys').child($rid).child($gid).exists() && newData.child('from').val() === auth.uid && root.child('pcases').child(auth.uid).child('key').val() === $gid && root.child('pcases').child(auth.uid).child('giftId').val() === newData.child('giftId').val() && root.child('pcases').child(auth.uid).child('price').val() === newData.child('price').val()) || (auth.uid === $rid && !data.exists() && !root.child('soldKeys').child($rid).child($gid).exists() && newData.child('from').val() === auth.uid && root.child('stars').child(auth.uid).child('cpending').child('key').val() === $gid && root.child('stars').child(auth.uid).child('cpending').child('giftId').val() === newData.child('giftId').val() && root.child('stars').child(auth.uid).child('cpending').child('value').val() === newData.child('price').val()) || (auth.uid === $rid && data.exists() && !newData.exists() && root.child('soldKeys').child($rid).child($gid).exists() && root.child('stars').child($rid).child('sale').child('key').val() === $gid))",
          ".validate": "newData.hasChildren(['giftId', 'from', 'price', 'at']) || !newData.exists()",
          "giftId": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "from": {
            ".validate": "newData.isString()"
          },
