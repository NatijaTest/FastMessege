        },
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.exists() && root.child('premium').child($uid).child('until').exists() && root.child('premium').child($uid).child('until').val() > now && (!data.exists() || newData.child('day').val() > data.child('day').val())))"
      }
    },
    "soldKeys": {
