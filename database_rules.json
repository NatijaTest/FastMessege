        ".validate": "newData.hasChildren(['key', 'giftId', 'price', 'at', 'day']) || !newData.exists()",
        "key": {
          ".validate": "newData.isString()"
        },
        "giftId": {
          ".validate": "newData.isString() && root.child('caseCatalog').child('premium').child('pool').child(newData.val()).val() === true"
        },
        "price": {
