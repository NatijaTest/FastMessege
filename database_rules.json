          },
          "$other": {
            ".validate": "root.child('admins').child(auth.uid).val() === true"
          },
          "case": {
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "cases": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true || root.child('moderators').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['key', 'giftId', 'price', 'at']) || !newData.exists()",
        "key": {
          ".validate": "newData.isString()"
        },
        "giftId": {
          ".validate": "newData.isString() && root.child('caseCatalog').child('basic').child('pool').child(newData.val()).val() === true"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() === root.child('giftCatalog').child(newData.parent().child('giftId').val()).child('price').val()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": "root.child('admins').child(auth.uid).val() === true"
        },
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists() && newData.exists()))"
      }
    },
    "premium": {
      ".read": "auth != null",
      ".write": "root.child('admins').child(auth.uid).val() === true",
