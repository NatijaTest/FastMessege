        },
        "cpending": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && ((!data.exists() && newData.exists() && newData.parent().child('balance').val() === data.parent().child('balance').val() - newData.child('cost').val()) || (data.exists() && !newData.exists()))))",
          ".validate": "newData.hasChildren(['key', 'caseId', 'giftId', 'cost', 'value']) || !newData.exists()",
          "key": {
            ".validate": "newData.isString()"
          },
          "caseId": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "giftId": {
